<Window x:Class="SwitchCfwTool.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Info" Height="520" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextBrush}"
        Icon="Assets/appicon.ico"
        TextOptions.TextFormattingMode="Ideal">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="12"
                BorderThickness="1" BorderBrush="{StaticResource BorderBrushSubtle}"
                Padding="16,14" Margin="0,0,0,14">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Switch-CFW-Tool" FontSize="19" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Tool made by Eule" FontWeight="SemiBold" FontSize="15"
                           Margin="0,8,0,0" HorizontalAlignment="Center"/>
                <TextBlock Margin="0,6,0,0" FontSize="15" HorizontalAlignment="Center">
                    <Run Text="🧋 " FontSize="17"/>
                    <Hyperlink NavigateUri="https://patreon.com/wander_eule?utm_medium=unknown&amp;utm_source=join_link&amp;utm_campaign=creatorshare_creator&amp;utm_content=copyLink"
                               RequestNavigate="Links_Navigate"
                               Foreground="{StaticResource TealBrush}">
                        <Run Text="Buy me a coffee on Patreon" FontWeight="SemiBold"/>
                    </Hyperlink>
                    <Run Text=" 🍰" FontSize="17"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12"
                BorderThickness="1" BorderBrush="{StaticResource BorderBrushSubtle}"
                Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="LISTED HOMEBREW TOOLS AND THEIR RESPECTIVE CREATORS"
                           FontSize="10.5" FontWeight="Bold" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel x:Name="CreditsPanel"/>
                        <Border Background="#1FFFFFFF" CornerRadius="8" Padding="12,10" Margin="0,16,6,2">
                            <StackPanel>
                                <TextBlock Text="DISCLAIMER" FontSize="10.5" FontWeight="Bold"
                                           TextAlignment="Center" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TealBrush}" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="17"
                                           TextAlignment="Center"
                                           Text="Switch-CFW-Tool is not affiliated with any of the homebrew listed above and claims no ownership of it. All rights remain with their respective creators. This application only downloads the publicly available releases from their official repositories, extracts them and arranges them into the correct SD card folder structure — no third-party software is bundled, modified or redistributed by this tool."/>
                                <TextBlock Text="🤍 SPECIAL THANKS 🤍" FontSize="12" FontWeight="Bold"
                                           TextAlignment="Center" HorizontalAlignment="Center"
                                           Margin="0,14,0,0"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="17"
                                           TextAlignment="Center" Margin="0,4,0,0"
                                           Text="to all homebrew creators who support the community"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <!-- Nudged past the window's content margin with a negative offset so it sits in
                 the actual bottom-left corner; it's decorative, so overflowing the layout
                 slightly is fine (the Grid doesn't clip). -->
            <TextBlock Text="༝༚༝༚" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                       FontSize="30" Margin="-6,0,0,-18"
                       Foreground="{StaticResource MutedBrush}"/>
            <Button Content="Close" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" Padding="20,7" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
