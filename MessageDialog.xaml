<Window x:Class="SwitchCfwTool.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextBrush}"
        Icon="Assets/appicon.ico"
        TextOptions.TextFormattingMode="Ideal">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Margin="18"
            BorderThickness="1" BorderBrush="{StaticResource BorderBrushSubtle}" Padding="18,16">
        <StackPanel>
            <TextBlock x:Name="HeadlineText" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                       TextAlignment="Center"/>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12.5"
                       TextAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
            <Button Content="OK" Style="{StaticResource PrimaryButton}" Padding="24,7"
                    HorizontalAlignment="Center" Margin="0,18,0,0" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </Border>
</Window>
