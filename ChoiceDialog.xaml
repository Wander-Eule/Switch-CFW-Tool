<Window x:Class="SwitchCfwTool.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Info" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextBrush}"
        Icon="Assets/appicon.ico"
        TextOptions.TextFormattingMode="Ideal">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Margin="18"
            BorderThickness="1" BorderBrush="{StaticResource BorderBrushSubtle}" Padding="18,16">
        <StackPanel>
            <TextBlock x:Name="HeadlineText" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"
                       TextAlignment="Center"/>
            <TextBlock x:Name="ReasonText" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12.5"
                       FontWeight="Bold" TextAlignment="Center"
                       Foreground="{StaticResource InfoBrush}"/>
            <TextBlock x:Name="QuestionText" TextWrapping="Wrap" Margin="0,14,0,0"
                       FontWeight="Bold" TextAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <!-- Teal check = confirm -->
                <Button x:Name="YesButton" Click="Yes_Click" Margin="0,0,26,0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <StackPanel Background="Transparent">
                                <Grid Width="46" Height="46">
                                    <Ellipse x:Name="Ring" Stroke="{StaticResource TealBrush}"
                                             StrokeThickness="2.4" Fill="#1A2DD4BF"/>
                                    <Path Stroke="{StaticResource TealBrush}" StrokeThickness="3"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 13,24 L 20,31 L 33,15"/>
                                </Grid>
                                <TextBlock Text="{TemplateBinding Tag}"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"
                                           FontSize="11.5" FontWeight="Bold"
                                           Foreground="{StaticResource TealBrush}"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="StrokeThickness" Value="3.2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Purple X = decline -->
                <Button x:Name="NoButton" Click="No_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <StackPanel Background="Transparent">
                                <Grid Width="46" Height="46">
                                    <Ellipse x:Name="Ring" Stroke="{StaticResource PurpleBrush}"
                                             StrokeThickness="2.4" Fill="#14A78BFA"/>
                                    <Path Stroke="{StaticResource PurpleBrush}" StrokeThickness="3"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 16,16 L 30,30 M 30,16 L 16,30"/>
                                </Grid>
                                <TextBlock Text="{TemplateBinding Tag}"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"
                                           FontSize="11.5" FontWeight="Bold"
                                           Foreground="{StaticResource PurpleBrush}"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="StrokeThickness" Value="3.2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
