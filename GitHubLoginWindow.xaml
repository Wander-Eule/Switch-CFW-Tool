<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SwitchCfwTool.Localization"
        x:Class="SwitchCfwTool.GitHubLoginWindow"
        Title="{l:Tr GitHub.Title}" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextBrush}"
        Icon="avares://Switch-CFW-Tool/Assets/appicon.ico">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Margin="18"
            BorderThickness="1" BorderBrush="{StaticResource BorderBrushSubtle}" Padding="20,18">
        <StackPanel>
            <TextBlock Text="{l:Tr GitHub.Headline}" FontSize="16" FontWeight="Bold"
                       TextAlignment="Center"/>
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12.5" TextAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"
                       Text="{l:Tr GitHub.Description}"/>

            <Button Classes="LinkButton" Margin="0,12,0,0" HorizontalAlignment="Center"
                    Click="Link_Click" Tag="https://github.com/settings/tokens/new">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{l:Tr GitHub.CreateToken}" FontWeight="SemiBold"
                               TextDecorations="Underline"/>
                    <!-- "Opens in the browser" arrow, drawn rather than typed: the bundled Inter
                         font has no glyph for it, and a fallback font that does isn't
                         guaranteed on every platform. -->
                    <Path Data="M 0.75,8.25 L 8.25,0.75 M 3,0.75 L 8.25,0.75 L 8.25,6"
                          StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                          Stroke="{Binding $parent[Button].Foreground}"
                          Margin="5,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TextBlock Text="{l:Tr GitHub.TokenLabel}" FontSize="10.5" FontWeight="Bold" Margin="0,16,0,6"
                       TextAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
            <TextBox x:Name="TokenBox" PasswordChar="•" Padding="8,6"/>

            <TextBlock x:Name="StatusText" Margin="0,10,0,0" FontSize="12" FontWeight="SemiBold"
                       TextAlignment="Center" TextWrapping="Wrap"/>

            <Grid Margin="0,16,0,0" ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Content="{l:Tr GitHub.LogOut}" Padding="14,6" Click="LogOut_Click"/>
                <Button Grid.Column="2" Content="{l:Tr GitHub.Save}" Classes="PrimaryButton"
                        Padding="18,6" Click="Save_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
