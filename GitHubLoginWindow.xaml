<Window x:Class="SwitchCfwTool.GitHubLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub Token" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextBrush}"
        Icon="Assets/appicon.ico"
        TextOptions.TextFormattingMode="Ideal">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Margin="18"
            BorderThickness="1" BorderBrush="{StaticResource BorderBrushSubtle}" Padding="20,18">
        <StackPanel>
            <TextBlock Text="Raise the GitHub rate limit" FontSize="16" FontWeight="Bold"
                       TextAlignment="Center"/>
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12.5" TextAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Without logging in, this app can make 60 GitHub requests per hour. A personal access token raises that to 5,000. No permissions are needed — this app only reads public release data, so a token with every box unchecked works fine."/>

            <TextBlock Margin="0,12,0,0" TextAlignment="Center">
                <Hyperlink NavigateUri="https://github.com/settings/tokens/new"
                           RequestNavigate="Links_Navigate"
                           Foreground="{StaticResource TealBrush}">
                    <Run Text="Create a token on GitHub ↗" FontWeight="SemiBold"/>
                </Hyperlink>
            </TextBlock>

            <TextBlock Text="TOKEN" FontSize="10.5" FontWeight="Bold" Margin="0,16,0,6"
                       TextAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
            <PasswordBox x:Name="TokenBox" Padding="8,6"/>

            <TextBlock x:Name="StatusText" Margin="0,10,0,0" FontSize="12" FontWeight="SemiBold"
                       TextAlignment="Center" TextWrapping="Wrap"/>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Log Out" Padding="14,6" Click="LogOut_Click"/>
                <Button Grid.Column="2" Content="Save" Style="{StaticResource PrimaryButton}"
                        Padding="18,6" Click="Save_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
