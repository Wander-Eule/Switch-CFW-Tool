<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SwitchCfwTool.Localization"
        x:Class="SwitchCfwTool.AccountNoticeDialog"
        Title="{l:Tr Common.InfoTitle}" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextBrush}"
        Icon="avares://Switch-CFW-Tool/Assets/appicon.ico">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Margin="18"
            BorderThickness="1" BorderBrush="{StaticResource BorderBrushSubtle}" Padding="18,16">
        <StackPanel>
            <TextBlock x:Name="HeadlineText" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"
                       TextAlignment="Center"/>
            <TextBlock x:Name="ReasonText" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="12.5"
                       FontWeight="Bold" TextAlignment="Center"
                       Foreground="{StaticResource InfoBrush}"/>
            <TextBlock x:Name="QuestionText" TextWrapping="Wrap" Margin="0,14,0,0"
                       FontWeight="Bold" TextAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <!-- Green arrow = go to the sign-up page -->
                <Button x:Name="GoButton" Classes="IconButton" Click="Go_Click" Margin="0,0,26,0" Cursor="Hand">
                    <StackPanel Background="Transparent">
                        <Grid Width="46" Height="46">
                            <Ellipse Classes="Ring" Stroke="{StaticResource GreenBrush}"
                                     StrokeThickness="2.4" Fill="#144ADE9E"/>
                            <Path Stroke="{StaticResource GreenBrush}" StrokeThickness="3"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Data="M 14,23 L 32,23 M 25,16 L 32,23 L 25,30"/>
                        </Grid>
                        <TextBlock x:Name="GoLabelText"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                   FontSize="11.5" FontWeight="Bold"
                                   Foreground="{StaticResource GreenBrush}"/>
                    </StackPanel>
                </Button>

                <!-- Purple X = already have an account, just continue -->
                <Button x:Name="HaveButton" Classes="IconButton" Click="Have_Click" Cursor="Hand">
                    <StackPanel Background="Transparent">
                        <Grid Width="46" Height="46">
                            <Ellipse Classes="Ring" Stroke="{StaticResource PurpleBrush}"
                                     StrokeThickness="2.4" Fill="#14A78BFA"/>
                            <Path Stroke="{StaticResource PurpleBrush}" StrokeThickness="3"
                                  StrokeLineCap="Round"
                                  Data="M 16,16 L 30,30 M 30,16 L 16,30"/>
                        </Grid>
                        <TextBlock x:Name="HaveLabelText"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                   FontSize="11.5" FontWeight="Bold"
                                   Foreground="{StaticResource PurpleBrush}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
