<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SwitchCfwTool.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- ============ Palette ============ -->
        <SolidColorBrush x:Key="PanelBrush" Color="#26264A" Opacity="0.55"/>
        <SolidColorBrush x:Key="PanelSolidBrush" Color="#242440"/>
        <SolidColorBrush x:Key="FieldBrush" Color="#2E2E52"/>
        <SolidColorBrush x:Key="BorderBrushSubtle" Color="#FFFFFF" Opacity="0.14"/>
        <SolidColorBrush x:Key="SeparatorBrush" Color="#FFFFFF" Opacity="0.07"/>
        <SolidColorBrush x:Key="TextBrush" Color="#ECECF7"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9A9AB8"/>
        <SolidColorBrush x:Key="TealBrush" Color="#2DD4BF"/>
        <SolidColorBrush x:Key="PurpleBrush" Color="#A78BFA"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#4ADE9E"/>
        <SolidColorBrush x:Key="InfoBrush" Color="#FFC86B"/>

        <LinearGradientBrush x:Key="WindowBackground" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#1F1F3D" Offset="0"/>
            <GradientStop Color="#191932" Offset="0.5"/>
            <GradientStop Color="#141428" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#8B5CF6" Offset="0"/>
            <GradientStop Color="#2DD4BF" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#332DD4BF"/>
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#242440"/>
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#24FFFFFF"/>

        <!-- Fluent pads a horizontal slider with 15 px above and below the track and a 32 px
             minimum height. The Theming window stacks three of them, and at that size they
             pushed the element list above down to half its height. -->
        <GridLength x:Key="SliderPreContentMargin">3</GridLength>
        <GridLength x:Key="SliderPostContentMargin">3</GridLength>
        <x:Double x:Key="SliderHorizontalHeight">20</x:Double>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>

        <!-- ============ Text ============ -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial, sans-serif"/>
        </Style>

        <Style Selector="ToolTip">
            <Setter Property="MaxWidth" Value="320"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#2A2A4E"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>

        <!-- ============ Round check / X checkbox ============ -->
        <Style Selector="CheckBox.ToolCheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial, sans-serif"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="22" Height="22" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" StrokeThickness="1.7"
                                     Stroke="{StaticResource PurpleBrush}" Fill="#14A78BFA"/>
                            <Path x:Name="XMark" Stroke="{StaticResource PurpleBrush}" StrokeThickness="1.9"
                                  StrokeLineCap="Round"
                                  Data="M 8,8 L 14,14 M 14,8 L 8,14"/>
                            <!-- Download arrow rather than a plain checkmark: a selected tool
                                 is something that will be downloaded, and the arrow says so
                                 at a glance. -->
                            <Path x:Name="CheckMark" Stroke="{StaticResource TealBrush}" StrokeThickness="2.1"
                                  StrokeLineCap="Round" IsVisible="False"
                                  Data="M 11,7 L 11,15 M 6.5,10.5 L 11,15 L 15.5,10.5"/>
                        </Grid>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="11,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox.ToolCheckBox:checked /template/ Ellipse#Ring">
            <Setter Property="Stroke" Value="{StaticResource TealBrush}"/>
            <Setter Property="Fill" Value="#1A2DD4BF"/>
        </Style>
        <Style Selector="CheckBox.ToolCheckBox:checked /template/ Path#XMark">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="CheckBox.ToolCheckBox:checked /template/ Path#CheckMark">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="CheckBox.ToolCheckBox:pointerover /template/ Ellipse#Ring">
            <Setter Property="StrokeThickness" Value="2.3"/>
        </Style>

        <!-- ============ Pill radio buttons ============ -->
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial, sans-serif"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Pill" CornerRadius="12" Padding="14,4"
                            Background="#22FFFFFF" BorderThickness="1"
                            BorderBrush="{StaticResource BorderBrushSubtle}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton:checked">
            <Setter Property="Foreground" Value="#12122A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="RadioButton:checked /template/ Border#Pill">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="RadioButton:unchecked:pointerover">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="RadioButton:unchecked:pointerover /template/ Border#Pill">
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>

        <!-- ============ Buttons ============ -->
        <Style Selector="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial, sans-serif"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#4DFFFFFF"/>
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>

        <Style Selector="Button.PrimaryButton">
            <Setter Property="Foreground" Value="#12122A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Button.PrimaryButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Opacity" Value="0.88"/>
        </Style>
        <Style Selector="Button.PrimaryButton:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <Style Selector="Button.IconButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.IconButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.IconButton:pointerover Ellipse.Ring">
            <Setter Property="StrokeThickness" Value="3.2"/>
        </Style>

        <Style Selector="Button.LinkButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TealBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.LinkButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>

        <!-- ============ TextBox ============ -->
        <Style Selector="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TealBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource TealBrush}"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial, sans-serif"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource TealBrush}"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
        </Style>

        <!-- ============ ProgressBar ============ -->
        <Style Selector="ProgressBar">
            <Setter Property="Background" Value="#2B2B4E"/>
            <Setter Property="Foreground" Value="{StaticResource AccentGradient}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="MinHeight" Value="14"/>
        </Style>

        <!-- ============ ComboBox ============ -->
        <Style Selector="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial, sans-serif"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{StaticResource TealBrush}"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="CornerRadius" Value="5"/>
        </Style>

        <!-- ============ Menu ============ -->
        <Style Selector="Menu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial, sans-serif"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="MenuItem.CheckedMenuItem">
            <Setter Property="Foreground" Value="{StaticResource TealBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ============ Tabs ============ -->
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial, sans-serif"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,7"/>
            <!-- Fluent gives tab headers a 48 px minimum height; these are pill buttons sized
                 by their padding instead. -->
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Bd" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Margin="{TemplateBinding Margin}"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#12122A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="TabItem:not(:selected):pointerover">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>

        <!-- ============ Slider ============ -->
        <Style Selector="Slider">
            <Setter Property="Foreground" Value="{StaticResource TealBrush}"/>
        </Style>
    </Application.Styles>
</Application>
