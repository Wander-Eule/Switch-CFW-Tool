<Window x:Class="SwitchCfwTool.ManageCfwWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage CFW" Height="620" Width="640"
        MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextBrush}"
        Icon="Assets/appicon.ico"
        TextOptions.TextFormattingMode="Ideal">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Manage CFW" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="UPDATE OR REMOVE TOOLS ON YOUR SD CARD" FontSize="11"
                       FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0"
                       Foreground="{StaticResource TealBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="SD CARD" VerticalAlignment="Center" FontWeight="Bold"
                       Margin="0,0,10,0" Foreground="{StaticResource TealBrush}" FontSize="12"/>
            <TextBox Grid.Column="1" x:Name="SdPathBox" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="Browse" Style="{StaticResource PrimaryButton}"
                    Margin="8,0,0,0" Padding="18,6" Click="Browse_Click"/>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="12"
                BorderThickness="1" BorderBrush="{StaticResource BorderBrushSubtle}" Padding="6,8">
            <Grid>
                <TextBlock x:Name="EmptyHint" TextWrapping="Wrap" TextAlignment="Center"
                           VerticalAlignment="Center" Margin="26" FontSize="12.5"
                           Foreground="{StaticResource MutedBrush}"
                           Text="Choose your SD card above to see what is installed."/>
                <ScrollViewer x:Name="ListScroller" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed" Margin="0,0,4,0">
                    <ItemsControl x:Name="InstalledList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource SeparatorBrush}" BorderThickness="0,0,0,1"
                                        Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding Details}" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Fixed box for the buttons, split into two equal-width
                                             columns. Update/Reload and Uninstall each centre inside
                                             their own column, so their icons sit at fixed, symmetric
                                             x-positions regardless of label text width — "Update/Reload"
                                             is wider than "Uninstall", so a plain HorizontalAlignment
                                             ="Center" on a shared StackPanel visibly skewed the pair.
                                             A lone Install button spans both columns and centres
                                             across the same total width, landing exactly on the
                                             midpoint between where the other two icons sit. -->
                                        <Grid Grid.Column="1" Width="152" Height="52" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Click="Update_Click" Tag="{Binding}" Cursor="Hand"
                                                    HorizontalAlignment="Center" VerticalAlignment="Top"
                                                    Visibility="{Binding UpdateButtonVisibility}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <StackPanel Background="Transparent">
                                                            <Grid Width="34" Height="34">
                                                                <Ellipse x:Name="R" Stroke="{StaticResource TealBrush}"
                                                                         StrokeThickness="2" Fill="#1A2DD4BF"/>
                                                                <Path Stroke="{StaticResource TealBrush}" StrokeThickness="2.4"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                      Data="M 17,11 L 17,23 M 10,17 L 17,23 L 24,17"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding ActionLabel}" HorizontalAlignment="Center"
                                                                       Margin="0,4,0,0" FontSize="10" FontWeight="Bold"
                                                                       Foreground="{StaticResource TealBrush}"/>
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="R" Property="StrokeThickness" Value="2.9"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <Button Grid.Column="1" Click="Uninstall_Click" Tag="{Binding}" Cursor="Hand"
                                                    HorizontalAlignment="Center" VerticalAlignment="Top"
                                                    Visibility="{Binding ManageVisibility}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <StackPanel Background="Transparent">
                                                            <Grid Width="34" Height="34">
                                                                <Ellipse x:Name="R" Stroke="{StaticResource PurpleBrush}"
                                                                         StrokeThickness="2" Fill="#14A78BFA"/>
                                                                <Path Stroke="{StaticResource PurpleBrush}" StrokeThickness="2.4"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                      Data="M 11,11 L 23,23 M 23,11 L 11,23"/>
                                                            </Grid>
                                                            <TextBlock Text="Uninstall" HorizontalAlignment="Center"
                                                                       Margin="0,4,0,0" FontSize="10" FontWeight="Bold"
                                                                       Foreground="{StaticResource PurpleBrush}"/>
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="R" Property="StrokeThickness" Value="2.9"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <Button Grid.Column="0" Grid.ColumnSpan="2" Click="Install_Click" Tag="{Binding}" Cursor="Hand"
                                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                                Visibility="{Binding InstallVisibility}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <StackPanel Background="Transparent">
                                                            <Grid Width="34" Height="34">
                                                                <Ellipse x:Name="R" Stroke="{StaticResource TealBrush}"
                                                                         StrokeThickness="2" Fill="#1A2DD4BF"/>
                                                                <Path Stroke="{StaticResource TealBrush}" StrokeThickness="2.4"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                      Data="M 17,11 L 17,23 M 10,17 L 17,23 L 24,17"/>
                                                            </Grid>
                                                            <TextBlock Text="Install" HorizontalAlignment="Center"
                                                                       Margin="0,4,0,0" FontSize="10" FontWeight="Bold"
                                                                       Foreground="{StaticResource TealBrush}"/>
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="R" Property="StrokeThickness" Value="2.9"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusText" VerticalAlignment="Center" HorizontalAlignment="Left"
                       FontSize="12" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="380"/>
            <!-- Shown only while a per-tool install/update/reload is running, same animated
                 gradient fill as the main window's build progress bar. -->
            <ProgressBar Grid.Column="1" x:Name="ActionProgress" Height="14" Margin="14,0"
                         VerticalAlignment="Center" Visibility="Collapsed"/>
            <Button Grid.Column="2" Content="Close" Style="{StaticResource PrimaryButton}" Padding="20,7"
                    HorizontalAlignment="Right" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
