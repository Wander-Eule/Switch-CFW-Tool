<Window x:Class="SwitchCfwTool.ThemingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SwitchCfwTool.Localization"
        Title="{l:Tr Theming.Title}" Height="790" Width="1030"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextBrush}"
        Icon="Assets/appicon.ico"
        TextOptions.TextFormattingMode="Ideal">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{l:Tr Theming.Title}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="{l:Tr Theming.Subtitle}" FontSize="11" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,3,0,0"
                       Foreground="{StaticResource TealBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{l:Tr Common.SdCardLabel}" VerticalAlignment="Center" FontWeight="Bold"
                       Margin="0,0,10,0" Foreground="{StaticResource TealBrush}" FontSize="12"/>
            <TextBox Grid.Column="1" x:Name="SdPathBox" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="{l:Tr Common.Browse}" Style="{StaticResource PrimaryButton}"
                    Margin="8,0,0,0" Padding="18,6" Click="BrowseSd_Click"/>
        </Grid>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">

            <!-- ========== Ultrahand ========== -->
            <TabItem Header="{l:Tr Theming.Tab.Ultrahand}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- editor -->
                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="12"
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrushSubtle}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{l:Tr Theming.EditorHeader}"
                                       FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"
                                       Margin="0,0,0,8" Foreground="{StaticResource TealBrush}"/>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="FieldList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <StackPanel>
                                            <TextBlock Text="{Binding Group}" Visibility="{Binding GroupVisibility}"
                                                       FontSize="10" FontWeight="Bold" Margin="8,10,0,4"
                                                       Foreground="{StaticResource TealBrush}"/>
                                            <Button Click="Field_Click" Tag="{Binding}" Cursor="Hand"
                                                    HorizontalContentAlignment="Stretch">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" CornerRadius="6" Padding="8,5"
                                                                Background="Transparent" Margin="0,0,0,2">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Width="18" Height="18"
                                                                        CornerRadius="4" Margin="0,0,10,0"
                                                                        Background="{Binding Swatch}"
                                                                        BorderThickness="1"
                                                                        BorderBrush="{StaticResource BorderBrushSubtle}"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                                           VerticalAlignment="Center" FontSize="12.5"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Display}"
                                                                           VerticalAlignment="Center" FontSize="11"
                                                                           FontFamily="Consolas"
                                                                           Foreground="{StaticResource MutedBrush}"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                          </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- sliders -->
                            <Border Grid.Row="2" Background="#1FFFFFFF" CornerRadius="8" Padding="12,10"
                                    Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="EditingLabel" Text="Text" FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <Grid x:Name="RgbPanel">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="34"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="R" VerticalAlignment="Center"
                                                   FontWeight="Bold" Foreground="#FF7B7B"/>
                                        <Slider Grid.Row="0" Grid.Column="1" x:Name="RSlider" Minimum="0" Maximum="255"
                                                VerticalAlignment="Center" Margin="6,3"
                                                ValueChanged="Channel_Changed"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Value, ElementName=RSlider, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="G" VerticalAlignment="Center"
                                                   FontWeight="Bold" Foreground="#7BFFB0"/>
                                        <Slider Grid.Row="1" Grid.Column="1" x:Name="GSlider" Minimum="0" Maximum="255"
                                                VerticalAlignment="Center" Margin="6,3"
                                                ValueChanged="Channel_Changed"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=GSlider, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="B" VerticalAlignment="Center"
                                                   FontWeight="Bold" Foreground="#7BB0FF"/>
                                        <Slider Grid.Row="2" Grid.Column="1" x:Name="BSlider" Minimum="0" Maximum="255"
                                                VerticalAlignment="Center" Margin="6,3"
                                                ValueChanged="Channel_Changed"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=BSlider, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"/>
                                    </Grid>

                                    <Grid x:Name="AlphaPanel" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="34"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="A" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <Slider Grid.Column="1" x:Name="ASlider" Minimum="0" Maximum="15"
                                                IsSnapToTickEnabled="True" TickFrequency="1"
                                                VerticalAlignment="Center" Margin="6,3"
                                                ValueChanged="Channel_Changed"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=ASlider, StringFormat={}{0:0}}"
                                                   VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="3" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{l:Tr Theming.Name}" VerticalAlignment="Center"
                                           FontWeight="Bold" Margin="0,0,8,0" FontSize="12"
                                           Foreground="{StaticResource TealBrush}"/>
                                <TextBox Grid.Column="1" x:Name="ThemeNameBox" Text="custom" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="{l:Tr Theming.SaveTheme}" Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" Padding="16,6" Click="SaveTheme_Click"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- live preview -->
                    <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="12"
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrushSubtle}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{l:Tr Theming.PreviewHeader}" FontSize="10.5" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,0,0,10"
                                       Foreground="{StaticResource TealBrush}"/>

                            <!-- Mock of the Ultrahand overlay; every brush is driven from code. Its
                                 texts are deliberately left untranslated: they stand in for
                                 Ultrahand's own screen, not for this program's. -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Border x:Name="PreviewRoot" CornerRadius="6" Padding="12,10"
                                    VerticalAlignment="Top" Background="#000000">
                                <StackPanel>

                                    <!-- ===== header: logo | divider | status widget ===== -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock x:Name="PvLogo" FontSize="21" FontWeight="Bold" Text="Ultrahand"/>
                                            <TextBlock x:Name="PvVersion" FontSize="8.5" Margin="1,-3,0,0"
                                                       Text="2.5.3  |  nx-ovlloader+ 2.0.2"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" x:Name="PvHeadDivider" Width="1.4" Margin="8,2,8,2"/>

                                        <!-- pill-shaped widget with its own travelling border -->
                                        <Border Grid.Column="2" x:Name="PvWidget" CornerRadius="14" BorderThickness="1.6"
                                                Padding="11,3" VerticalAlignment="Center">
                                            <StackPanel>
                                                <TextBlock x:Name="PvClock" Text="Wed 15:33:01" FontSize="11"
                                                           HorizontalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock x:Name="PvTemp" Text="32°C" FontSize="11"/>
                                                    <TextBlock x:Name="PvBattery" Text=" 79%" FontSize="11"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border x:Name="PvHeaderSep" Height="1.2" Margin="0,7,0,9"/>

                                    <!-- ===== section: toggles ===== -->
                                    <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                                        <Border x:Name="PvSec1Bar" Width="3" Height="13" CornerRadius="1.5" Margin="0,0,7,0"/>
                                        <TextBlock x:Name="PvSec1Text" Text="Notification Settings" FontSize="11.5"/>
                                    </StackPanel>

                                    <Border x:Name="PvSelection" CornerRadius="8" Padding="10,6" BorderThickness="2">
                                        <Grid>
                                            <TextBlock x:Name="PvSelectedText" Text="Silence Notifications" FontSize="13"
                                                       VerticalAlignment="Center"/>
                                            <Border x:Name="PvToggleOffTrack" Width="38" Height="19" CornerRadius="10"
                                                    HorizontalAlignment="Right">
                                                <Border x:Name="PvToggleOffKnob" Width="15" Height="15" CornerRadius="8"
                                                        HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Grid Margin="12,7,10,0">
                                        <TextBlock x:Name="PvItem2" Text="Startup Notification" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <Border x:Name="PvToggleOnTrack" Width="38" Height="19" CornerRadius="10"
                                                HorizontalAlignment="Right">
                                            <Border x:Name="PvToggleOnKnob" Width="15" Height="15" CornerRadius="8"
                                                    HorizontalAlignment="Right" Margin="0,0,2,0"/>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="12,7,10,0">
                                        <TextBlock x:Name="PvItem3" Text="API Notifications" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <Border x:Name="PvToggleOnTrack2" Width="38" Height="19" CornerRadius="10"
                                                HorizontalAlignment="Right">
                                            <Border x:Name="PvToggleOnKnob2" Width="15" Height="15" CornerRadius="8"
                                                    HorizontalAlignment="Right" Margin="0,0,2,0"/>
                                        </Border>
                                    </Grid>

                                    <!-- ===== trackbar ===== -->
                                    <Grid Margin="16,14,10,0">
                                        <TextBlock x:Name="PvTrackLabel" Text="Max Slots" FontSize="12.5"
                                                   HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="PvTrackValue" Text="2" FontSize="12.5"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Height="18" Margin="16,3,10,0">
                                        <Border x:Name="PvTrackEmpty" Height="4" CornerRadius="2"
                                                VerticalAlignment="Center"/>
                                        <Border x:Name="PvTrackFull" Height="4" CornerRadius="2" Width="42"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <Border x:Name="PvTrackKnob" Width="17" Height="17" CornerRadius="9"
                                                BorderThickness="2"
                                                HorizontalAlignment="Left" Margin="35,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- ===== section: table ===== -->
                                    <StackPanel Orientation="Horizontal" Margin="2,14,0,6">
                                        <Border x:Name="PvSec2Bar" Width="3" Height="13" CornerRadius="1.5" Margin="0,0,7,0"/>
                                        <TextBlock x:Name="PvSec2Text" Text="Device Info" FontSize="11.5"/>
                                    </StackPanel>

                                    <Border x:Name="PvTable" CornerRadius="8" BorderThickness="1.6" Padding="10,7">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock x:Name="PvTableL1" Text="Dismiss Notification" FontSize="11"
                                                           HorizontalAlignment="Left"/>
                                                <TextBlock x:Name="PvTableV1" Text="(click)" FontSize="11"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,3,0,0">
                                                <TextBlock x:Name="PvTableL2" Text="API Toggle" FontSize="11"
                                                           HorizontalAlignment="Left"/>
                                                <TextBlock x:Name="PvTableV2" Text="(hold for 4s)" FontSize="11"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- ===== section: radio list ===== -->
                                    <StackPanel Orientation="Horizontal" Margin="2,14,0,6">
                                        <Border x:Name="PvSec3Bar" Width="3" Height="13" CornerRadius="1.5" Margin="0,0,7,0"/>
                                        <TextBlock x:Name="PvSec3Text" Text="Language" FontSize="11.5"/>
                                    </StackPanel>

                                    <Grid Margin="12,0,10,0">
                                        <TextBlock x:Name="PvRadioItem1" Text="English" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="PvRadioCode1" Text="en" FontSize="11"
                                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <Grid Width="18" Height="18">
                                                <Ellipse x:Name="PvRadioRing1" StrokeThickness="2"/>
                                                <Ellipse x:Name="PvRadioDot1" Width="7" Height="7"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="12,7,10,0">
                                        <TextBlock x:Name="PvRadioItem2" Text="Spanish" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="PvRadioCode2" Text="es" FontSize="11"
                                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <Grid Width="18" Height="18">
                                                <Ellipse x:Name="PvRadioRing2" StrokeThickness="2"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <!-- ===== bottom button hints ===== -->
                                    <Grid Margin="4,16,4,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Border x:Name="PvBackBadge" Width="17" Height="17" CornerRadius="9"
                                                    Margin="0,0,6,0">
                                                <TextBlock Text="B" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock x:Name="PvBackText" Text="Back" FontSize="12.5"
                                                       VerticalAlignment="Center" Margin="0,0,18,0"/>
                                            <Border x:Name="PvOkBadge" Width="17" Height="17" CornerRadius="9"
                                                    Margin="0,0,6,0">
                                                <TextBlock Text="A" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFF"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock x:Name="PvOkText" Text="OK" FontSize="12.5"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                </StackPanel>
                            </Border>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <!-- ===== bundled wallpapers ===== -->
                    <Border Grid.Column="4" Background="{StaticResource PanelBrush}" CornerRadius="12"
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrushSubtle}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{l:Tr Theming.WallpaperHeader}" FontSize="10.5" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,0,0,10"
                                       Foreground="{StaticResource TealBrush}"/>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="WallpaperList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <!-- Clipped to the rounded corners so the artwork meets
                                                 the frame instead of leaving a lighter margin. -->
                                            <Border CornerRadius="6" BorderThickness="1"
                                                    BorderBrush="{StaticResource BorderBrushSubtle}"
                                                    Width="92" Height="148">
                                                <Border.Clip>
                                                    <RectangleGeometry Rect="0,0,92,148" RadiusX="6" RadiusY="6"/>
                                                </Border.Clip>
                                                <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           HorizontalAlignment="Center" Margin="0,0,10,8"/>
                                                <Button Click="Wallpaper_Click" Tag="{Binding}" Cursor="Hand"
                                                        HorizontalAlignment="Center" Margin="0,0,10,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Grid Width="32" Height="32">
                                                                <!-- purple X while unselected, teal tick once picked -->
                                                                <Ellipse x:Name="Ring" StrokeThickness="2"
                                                                         Stroke="{StaticResource PurpleBrush}"
                                                                         Fill="#14A78BFA"/>
                                                                <Path x:Name="Cross" Stroke="{StaticResource PurpleBrush}"
                                                                      StrokeThickness="2.2"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                      Data="M 11,11 L 21,21 M 21,11 L 11,21"/>
                                                                <Path x:Name="Tick" Visibility="Collapsed"
                                                                      Stroke="{StaticResource TealBrush}"
                                                                      StrokeThickness="2.4"
                                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                      Data="M 9,16.5 L 14,21.5 L 23,10.5"/>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter TargetName="Ring" Property="Stroke"
                                                                            Value="{StaticResource TealBrush}"/>
                                                                    <Setter TargetName="Ring" Property="Fill" Value="#1A2DD4BF"/>
                                                                    <Setter TargetName="Cross" Property="Visibility" Value="Collapsed"/>
                                                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Ring" Property="StrokeThickness" Value="2.8"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========== Hekate ========== -->
            <TabItem Header="{l:Tr Theming.Tab.Hekate}">
                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Margin="0,12,0,0"
                        BorderThickness="1" BorderBrush="{StaticResource BorderBrushSubtle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{l:Tr Theming.Hekate.Header}" FontSize="10.5" FontWeight="Bold"
                                       HorizontalAlignment="Center" Foreground="{StaticResource TealBrush}"/>
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12.5" Margin="0,10,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="{l:Tr Theming.Hekate.Description}"/>
                        </StackPanel>

                        <Border Grid.Row="1" Margin="0,16,0,0" CornerRadius="8" Background="#1FFFFFFF"
                                BorderThickness="1" BorderBrush="{StaticResource BorderBrushSubtle}">
                            <Grid>
                                <TextBlock x:Name="WallpaperHint" Text="{l:Tr Theming.Hekate.NoImage}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}" FontSize="12.5"/>
                                <Image x:Name="WallpaperPreview" Stretch="Uniform" Margin="10"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{l:Tr Theming.Hekate.ChooseImage}" Padding="16,6" Click="ChooseWallpaper_Click"/>
                            <TextBlock Grid.Column="1" x:Name="WallpaperStatus" VerticalAlignment="Center"
                                       Margin="14,0" FontSize="12" FontWeight="Bold" TextWrapping="Wrap"/>
                            <Button Grid.Column="2" Content="{l:Tr Theming.Hekate.Apply}" Style="{StaticResource PrimaryButton}"
                                    Padding="18,6" Click="ApplyWallpaper_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
